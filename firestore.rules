rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'swamiramesh9785@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 120 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.role in ['student', 'admin'] &&
             data.testsAttempted is int && data.testsAttempted >= 0 &&
             data.bestScore is number &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMock(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000)) &&
             data.category is string && data.category.size() <= 100 &&
             data.durationMinutes is int && data.durationMinutes > 0 && data.durationMinutes <= 360 &&
             data.totalMarks is number && data.totalMarks >= 0 &&
             data.positiveMark is number && data.positiveMark > 0 &&
             data.negativeMark is number && data.negativeMark >= 0 &&
             data.isPublished is bool &&
             data.questionCount is int && data.questionCount >= 0 &&
             data.questions is list && data.questions.size() <= 200 &&
             data.createdBy is string && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidResult(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.mockId is string && data.mockId.size() <= 128 &&
             data.mockTitle is string && data.mockTitle.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.score is number &&
             data.totalMarks is number && data.totalMarks >= 0 &&
             data.correctCount is int && data.correctCount >= 0 &&
             data.incorrectCount is int && data.incorrectCount >= 0 &&
             data.unattemptedCount is int && data.unattemptedCount >= 0 &&
             data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
             data.timeTakenSeconds is int && data.timeTakenSeconds >= 0 &&
             (!('answersJson' in data) || data.answersJson == null || (data.answersJson is string && data.answersJson.size() <= 50000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLeaderboard(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 100 &&
             (!('userPhoto' in data) || data.userPhoto == null || (data.userPhoto is string && data.userPhoto.size() <= 500)) &&
             data.mockId is string && data.mockId.size() <= 128 &&
             data.mockTitle is string && data.mockTitle.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.score is number &&
             data.totalMarks is number && data.totalMarks >= 0 &&
             data.timeTakenSeconds is int && data.timeTakenSeconds >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       (incoming().role == 'student' || isAdmin()) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
                       (request.auth.uid == userId || isAdmin()) &&
                       incoming().userId == existing().userId &&
                       (incoming().role == existing().role || isAdmin()) &&
                       isValidUserProfile(incoming());
      allow delete: if isAdmin();

      // Student results subcollection
      match /results/{resultId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidResult(incoming());
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Mock examinations
    match /mocks/{mockId} {
      allow get: if isSignedIn() && (resource.data.isPublished == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.isPublished == true || isAdmin());
      allow create: if isAdmin() && isValidMock(incoming());
      allow update: if isAdmin() && isValidMock(incoming());
      allow delete: if isAdmin();
    }

    // Global Leaderboard
    match /leaderboard/{attemptId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.auth.uid == incoming().userId &&
                       isValidLeaderboard(incoming());
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
